# ===========================================
# Diabetics-AI Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control

# -----------------------------------------
# Database (PostgreSQL)
# -----------------------------------------
# For Vercel Postgres (recommended for production):
# 1. Create a Postgres database in your Vercel project settings
# 2. Copy the connection strings from the Vercel dashboard
#
# DATABASE_URL is the pooled connection (for serverless)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&pgbouncer=true"
# DIRECT_URL is the direct connection (for migrations)
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# For local development with PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diabetics_ai"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/diabetics_ai"

# -----------------------------------------
# NextAuth.js
# -----------------------------------------
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl"
# For local development:
NEXTAUTH_URL="http://localhost:3000"
# Note: On Vercel, NEXTAUTH_URL is automatically set to your deployment URL

# -----------------------------------------
# OpenAI API
# -----------------------------------------
# Required for chat, AI insights, and text-to-speech features
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# -----------------------------------------
# Stripe (Subscriptions)
# -----------------------------------------
# Required for premium subscription features
# Get your keys at https://dashboard.stripe.com/apikeys

# Secret key (starts with sk_test_ for test mode or sk_live_ for production)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"

# Publishable key (starts with pk_test_ for test mode or pk_live_ for production)
# Used client-side for Stripe.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"

# Webhook secret for verifying webhook events
# Get this when you create a webhook endpoint in Stripe Dashboard
# For local development, use Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Price ID for the Premium subscription plan
# Create a product and price in Stripe Dashboard → Products
# The price should be set to $9.99/month recurring
STRIPE_PRICE_ID="price_your-premium-price-id"
